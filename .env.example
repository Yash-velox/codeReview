# Code Review Agent — Environment Variables
# Copy this file to .env and fill in your actual values.
# Never commit .env to version control.

# OpenAI API key (create at https://platform.openai.com/api-keys — usage billed per token / credits).
OPENAI_API_KEY=your-openai-api-key-here

# Optional: model id (default gpt-4o-mini — inexpensive and suitable for reviews).
# OPENAI_MODEL=gpt-4o-mini

# Optional: override API base URL (leave unset for official OpenAI https://api.openai.com/v1).
# OPENAI_BASE_URL=

# Base URL of your Jira instance (e.g. https://yourcompany.atlassian.net)
JIRA_URL=https://your-jira-instance.atlassian.net

# Email address associated with your Jira account
JIRA_EMAIL=your-email@example.com

# Jira API token (generate at https://id.atlassian.com/manage-profile/security/api-tokens)
JIRA_API_TOKEN=your-jira-api-token-here
