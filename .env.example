# Code Review Agent — Environment Variables
# Copy this file to .env and fill in your actual values.
# Never commit .env to version control.

# xAI API key for accessing Grok-1 via the xAI API
XAI_API_KEY=your-xai-api-key-here

# Base URL of your Jira instance (e.g. https://yourcompany.atlassian.net)
JIRA_URL=https://your-jira-instance.atlassian.net

# Email address associated with your Jira account
JIRA_EMAIL=your-email@example.com

# Jira API token (generate at https://id.atlassian.com/manage-profile/security/api-tokens)
JIRA_API_TOKEN=your-jira-api-token-here
