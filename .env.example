# Code Review Agent — Environment Variables
# Copy this file to .env and fill in your actual values.
# Never commit .env to version control.

# Groq API key — https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here

# Chat model id (Groq-hosted; defaults to llama-3.3-70b-versatile)
# List: https://console.groq.com/docs/models
# GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI-compatible base URL (normally leave unset — uses Groq defaults)
# GROQ_API_BASE=https://api.groq.com/openai/v1

# Base URL of your Jira instance (e.g. https://yourcompany.atlassian.net)
JIRA_URL=https://your-jira-instance.atlassian.net

# Email address associated with your Jira account
JIRA_EMAIL=your-email@example.com

# Jira API token (generate at https://id.atlassian.com/manage-profile/security/api-tokens)
JIRA_API_TOKEN=your-jira-api-token-here
