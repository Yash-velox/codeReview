"""
tools/git_tool.py — GitDiffCollector

Captures staged code changes by running `git diff --staged` via the
subprocess module and exposes the function as a LangChain Tool.

No credentials are required; the command runs in the current working directory.
"""

import subprocess

from langchain_core.tools import Tool

# ---------------------------------------------------------------------------
# Core diff collection function
# ---------------------------------------------------------------------------


def collect_git_diff(_: str = "") -> str:
    """Run ``git diff --staged`` and return the output as a string.

    The optional ignored argument (``_``) exists solely to satisfy the
    LangChain Tool interface, which always passes a string input to the
    wrapped function.

    Returns:
        The full stdout of ``git diff --staged`` when staged changes exist.
        A descriptive message string when no files are staged or when git
        is unavailable / the directory is not a git repository.
        Never raises an exception to the caller.
    """
    try:
        # --- Execute git diff --staged, capturing stdout and stderr ---
        result = subprocess.run(
            ["git", "diff", "--staged"],
            capture_output=True,
            text=True,
            check=True,  # raises CalledProcessError on non-zero exit code
        )

        # --- An empty stdout means no files have been staged ---
        if not result.stdout.strip():
            return "No staged changes found."

        # --- Return the full diff output as a plain string ---
        return result.stdout

    except FileNotFoundError:
        # git binary is not installed or not on PATH
        return (
            "Error: 'git' command not found. "
            "Ensure git is installed and available on your PATH."
        )
    except subprocess.CalledProcessError as exc:
        # git exited with a non-zero code — most likely not a git repository
        stderr_detail = exc.stderr.strip() if exc.stderr else "no details available"
        return (
            f"Error: 'git diff --staged' failed (exit code {exc.returncode}). "
            f"The working directory may not be a git repository. "
            f"Details: {stderr_detail}"
        )
    except Exception as exc:  # noqa: BLE001
        # Catch-all for any other unexpected subprocess-related errors
        return f"Error: Unexpected error while running git diff: {exc}"


# ---------------------------------------------------------------------------
# LangChain Tool registration
# ---------------------------------------------------------------------------

# Expose collect_git_diff as a named LangChain Tool so the ReAct agent can
# discover and invoke it by name during its reasoning loop.
git_diff_collector = Tool(
    name="git_diff_collector",
    func=collect_git_diff,
    description=(
        "Captures the currently staged git changes by running `git diff --staged`. "
        "Takes no meaningful input (pass an empty string or omit). "
        "Returns the full diff as a string when staged changes exist, "
        "'No staged changes found.' when nothing is staged, "
        "or a descriptive error string if git is unavailable or the directory "
        "is not a git repository."
    ),
)
